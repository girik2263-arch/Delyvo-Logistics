.nav-title{font-size:11px;color:#98a2b3;text-transform:uppercase;padding:12px}
.nav{display:grid;gap:5px}
.nav a{
  color:#cbd5e1;text-decoration:none;padding:12px 13px;border-radius:9px;
  display:flex;align-items:center;gap:12px;font-size:14px
}
.nav a:hover,.nav a.active{background:#1d4ed8;color:#fff}
.nav-icon{width:20px;text-align:center}

.main{margin-left:250px;width:calc(100% - 250px);padding:28px}

.topbar{
  display:flex;justify-content:space-between;align-items:center;
  margin-bottom:28px
}
.title h1{font-size:28px}
.title p{color:#667085;margin-top:6px;font-size:14px}
.profile{
  background:#fff;border:1px solid #e4e7ec;border-radius:12px;
  padding:10px 14px;display:flex;gap:10px;align-items:center
}
.avatar{
  width:34px;height:34px;border-radius:50%;background:#1d4ed8;color:#fff;
  display:grid;place-items:center;font-weight:700
}
.profile small{display:block;color:#667085;margin-top:2px}

.stats{
  display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:22px
}
.stat{
  background:#fff;border:1px solid #e4e7ec;border-radius:14px;padding:20px
}
.stat-top{display:flex;justify-content:space-between;color:#667085;font-size:13px}
.stat-icon{
  width:38px;height:38px;border-radius:10px;background:#eff6ff;
  display:grid;place-items:center;color:#1d4ed8;font-size:18px
}
.stat-number{font-size:30px;font-weight:800;margin-top:15px}
.stat-change{font-size:12px;color:#667085;margin-top:7px}

.grid{
  display:grid;grid-template-columns:2fr 1fr;gap:20px
}
.panel{
  background:#fff;border:1px solid #e4e7ec;border-radius:14px;
  padding:21px;margin-bottom:20px
}
.panel-head{
  display:flex;justify-content:space-between;align-items:center;margin-bottom:18px
}
.panel h2{font-size:17px}
.view{font-size:13px;color:#1d4ed8;text-decoration:none}

table{width:100%;border-collapse:collapse}
th,td{
  padding:13px 8px;text-align:left;border-bottom:1px solid #eef2f6;
  font-size:13px
}
th{color:#667085;font-weight:600}
.badge{
  display:inline-block;padding:5px 9px;border-radius:20px;
  background:#ecfdf3;color:#027a48;font-size:11px;font-weight:600
}
.badge.transit{background:#eff8ff;color:#175cd3}
.badge.pending{background:#fffaeb;color:#b54708}

.actions{display:grid;gap:10px}
.action{
  border:1px solid #e4e7ec;background:#fff;border-radius:10px;
  padding:13px;text-align:left;cursor:pointer
}
.action:hover{background:#f8fafc}
.action strong{display:block;font-size:13px}
.action span{font-size:11px;color:#667085}

.activity{display:grid;gap:16px}
.activity-item{display:flex;gap:12px}
.dot{
  width:9px;height:9px;border-radius:50%;background:#2563eb;margin-top:5px;
  flex:none
}
.activity-item p{font-size:13px}
.activity-item small{display:block;color:#98a2b3;margin-top:3px}

.mobile-nav{display:none}

@media(max-width:1000px){
  .stats{grid-template-columns:repeat(2,1fr)}
  .grid{grid-template-columns:1fr}
}
@media(max-width:700px){
  .sidebar{display:none}
  .main{margin-left:0;width:100%;padding:18px;padding-bottom:80px}
  .stats{grid-template-columns:1fr 1fr;gap:12px}
  .stat{padding:16px}
  .stat-number{font-size:25px}
  .topbar{align-items:flex-start}
  .profile{padding:7px}
  .profile div:not(.avatar){display:none}
  table{min-width:620px}
  .panel{overflow-x:auto}
  .panel-head{overflow:visible}
  .mobile-nav{
    display:flex;position:fixed;bottom:0;left:0;right:0;background:#fff;
    border-top:1px solid #e4e7ec;z-index:20;justify-content:space-around;padding:9px 4px
  }
  .mobile-nav a{font-size:10px;color:#667085;text-decoration:none;text-align:center}
  .mobile-nav a.active{color:#1d4ed8;font-weight:700}
}
</style>
