<script>
async function loadShipmentCompanies() {
  const select = document.getElementById("shipmentCompanyId");

  if (!select) return;

  select.innerHTML = '<option value="">Loading companies...</option>';

  try {
    const response = await fetch("/api/companies");

    if (!response.ok) {
      throw new Error("Unable to load companies");
    }

    const data = await response.json();

    const companies = Array.isArray(data)
      ? data
      : (data.companies || data.data || []);

    if (!companies.length) {
      select.innerHTML =
        '<option value="">No companies available</option>';
      return;
    }

    select.innerHTML =
      '<option value="">Select company</option>';

    companies.forEach(company => {
      const option = document.createElement("option");

      option.value = company.id;

      option.textContent =
        company.name ||
        company.company_name ||
        company.code ||
        company.id;

      select.appendChild(option);
    });

  } catch (error) {
    console.error("Company loading failed:", error);

    select.innerHTML =
      '<option value="">Unable to load companies</option>';
  }
}


function openShipmentModal() {
  const modal = document.getElementById("shipmentModal");

  if (!modal) return;

  modal.style.display = "flex";

  loadShipmentCompanies();

  const message =
    document.getElementById("shipmentMessage");

  if (message) {
    message.textContent = "";
  }
}


function closeShipmentModal() {
  const modal = document.getElementById("shipmentModal");

  if (modal) {
    modal.style.display = "none";
  }
}


async function createShipmentFromDashboard(event) {
  event.preventDefault();

  const message =
    document.getElementById("shipmentMessage");

  const submitButton =
    document.querySelector("#shipmentForm button[type='submit']");

  const companyId =
    document.getElementById("shipmentCompanyId").value.trim();

  const city =
    document.getElementById("shipmentCity").value.trim();

  if (!companyId || !city) {
    message.textContent =
      "Company and delivery city are required.";

    return;
  }

  const awbInput =
    document.getElementById("shipmentAwb").value.trim();

  const payload = {
    company_id: companyId,
    awb: awbInput,
    delivery_city: city,
    customer_name:
      document.getElementById("shipmentCustomer").value.trim(),
    customer_phone:
      document.getElementById("shipmentPhone").value.trim(),
    delivery_address:
      document.getElementById("shipmentAddress").value.trim(),
    cod_amount:
      Number(document.getElementById("shipmentCod").value || 0)
  };

  message.textContent = "Creating shipment...";

  if (submitButton) {
    submitButton.disabled = true;
    submitButton.textContent = "Creating...";
  }

  try {
    const response = await fetch("/api/shipments", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(payload)
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(
        data.error ||
        "Shipment creation failed"
      );
    }

    message.textContent =
      "Shipment created successfully ✅";

    document.getElementById("shipmentForm").reset();

    await loadDashboard();

    setTimeout(() => {
      closeShipmentModal();
    }, 700);

  } catch (error) {
    console.error("Shipment creation failed:", error);

    message.textContent =
      "❌ " + error.message;

  } finally {
    if (submitButton) {
      submitButton.disabled = false;
      submitButton.textContent = "Create Shipment";
    }
  }
}


document.addEventListener("DOMContentLoaded", () => {

  const form =
    document.getElementById("shipmentForm");

  if (form) {
    form.addEventListener(
      "submit",
      createShipmentFromDashboard
    );
  }

  document.querySelectorAll("button, a").forEach(element => {

    const label =
      (element.textContent || "")
      .trim()
      .toLowerCase();

    if (label.includes("create shipment")) {

      element.addEventListener("click", event => {
        event.preventDefault();
        openShipmentModal();
      });

    }

  });

});
</script>

