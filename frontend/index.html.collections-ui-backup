<script>
async function dc(x){
  const box=document.getElementById("dcbox");
  box.textContent="Loading...";
  try{
    let url="/api/control/"+x;
    if(x==="finance") url="/api/finance/summary";
    if(x==="reports") url="/api/reports/status";
    const r=await fetch(url);
