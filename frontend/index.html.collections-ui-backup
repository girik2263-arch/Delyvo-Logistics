<script>
async function loadDashboard() {
  try {
    const response = await fetch("/api/dashboard");
    if (!response.ok) throw new Error("Dashboard API failed");

    const data = await response.json();
    const stats = data.stats || {};

    document.getElementById("totalShipments").textContent =
      stats.total_shipments ?? 0;

    document.getElementById("inTransit").textContent =
      stats.in_transit ?? 0;

    document.getElementById("delivered").textContent =
      stats.delivered ?? 0;

    document.getElementById("activePilots").textContent =
      stats.active_pilots ?? 0;

    document.getElementById("companiesCount").textContent =
      stats.companies ?? 0;

    document.getElementById("hubsCount").textContent =
      stats.hubs ?? 0;

    // Update recent shipments table from the live API
    const tbody = document.querySelector("table tbody");
    const shipments = data.recent_shipments || [];

    if (shipments.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td>—</td>
          <td>No shipments</td>
          <td>—</td>
          <td><span class="badge pending">Waiting</span></td>
        </tr>
      `;
    } else {
      tbody.innerHTML = shipments.map(shipment => {
        const status = shipment.status || "unknown";

        let badgeClass = "pending";
        if ([
          "pickup_requested",
          "picked_up",
          "at_hub",
          "out_for_delivery"
        ].includes(status)) {
          badgeClass = "transit";
        } else if (status === "delivered") {
          badgeClass = "";
        }

        return `
          <tr>
            <td>${shipment.awb || shipment.id || "—"}</td>
            <td>${shipment.company_id || "—"}</td>
            <td>${shipment.delivery_city || "—"}</td>
            <td>
              <span class="badge ${badgeClass}">
                ${status.replaceAll("_", " ")}
              </span>
            </td>
          </tr>
        `;
      }).join("");
    }

  } catch (error) {
    console.error("Dashboard load failed:", error);
  }
}

loadDashboard();
</script>





