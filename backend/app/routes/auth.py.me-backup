from datetime import datetime, timezone

from flask import Blueprint, jsonify, request

from app.services.auth_service import (
    create_token,
    hash_password,
    hash_token,
    session_expiry,
    verify_password,
)
from app.services.messagecentral import send_otp as mc_send_otp
from app.services.messagecentral import verify_otp as mc_verify_otp
from app.services.supabase_client import supabase_request


auth_bp = Blueprint("auth", __name__, url_prefix="/api/auth")

VALID_ROLES = {"control", "company", "hub", "pilot"}


def normalize_phone(phone):
    if not phone:
        return None

    digits = "".join(ch for ch in str(phone) if ch.isdigit())

    if digits.startswith("91") and len(digits) == 12:
        digits = digits[2:]

    if len(digits) != 10:
        return None

    if digits[0] not in "6789":
        return None

    return digits


def get_bearer_token():
    header = request.headers.get("Authorization", "")

    if not header.startswith("Bearer "):
        return None

    return header[7:].strip()


def get_user_by_email(email):
    rows = supabase_request(
        "GET",
        "users",
        params={
            "select": "id,company_id,name,email,phone,password_hash,role,status",
            "email": f"eq.{email}",
            "limit": "1",
        },
    )

    return rows[0] if rows else None


def get_user_by_phone(phone):
    rows = supabase_request(
        "GET",
        "users",
        params={
            "select": "id,company_id,name,email,phone,password_hash,role,status",
            "phone": f"eq.{phone}",
            "limit": "1",
        },
    )

    return rows[0] if rows else None


def user_response(user):
    return {
        "id": user["id"],
        "name": user["name"],
        "email": user["email"],
        "phone": user.get("phone"),
        "role": user["role"],
        "company_id": user.get("company_id"),
        "status": user["status"],
    }


@auth_bp.post("/register")
def register():
    data = request.get_json(silent=True) or {}

    name = str(data.get("name", "")).strip()
    email = str(data.get("email", "")).strip().lower()
    phone = normalize_phone(data.get("phone"))
    password = str(data.get("password", ""))
    role = str(data.get("role", "")).strip().lower()
    company_id = data.get("company_id")

    if not name:
        return jsonify({"error": "Name is required"}), 400

    if not email:
        return jsonify({"error": "Email is required"}), 400

    if len(password) < 8:
        return jsonify({"error": "Password must be at least 8 characters"}), 400

    if role not in VALID_ROLES:
        return jsonify({"error": "Invalid role"}), 400

    if phone is None:
        return jsonify({"error": "Valid Indian phone number is required"}), 400

    if role == "company" and not company_id:
        return jsonify({"error": "company_id is required for company users"}), 400

    existing = get_user_by_email(email)

    if existing:
        return jsonify({"error": "Email already registered"}), 409

    if company_id:
        companies = supabase_request(
            "GET",
            "companies",
            params={
                "select": "id,status",
                "id": f"eq.{company_id}",
                "limit": "1",
            },
        )

        if not companies:
            return jsonify({"error": "Company not found"}), 400

        if companies[0]["status"] != "active":
            return jsonify({"error": "Company is inactive"}), 400

    now = datetime.now(timezone.utc).isoformat()

    payload = {
        "name": name,
        "email": email,
        "phone": phone,
        "password_hash": hash_password(password),
        "role": role,
        "status": "active",
        "created_at": now,
        "updated_at": now,
    }

    if company_id:
        payload["company_id"] = company_id

    try:
        created = supabase_request(
            "POST",
            "users",
            params={"select": "id,company_id,name,email,phone,role,status"},
            json=payload,
        )
    except Exception as exc:
        message = str(exc)

        if "duplicate key" in message.lower():
            return jsonify({"error": "Email or phone already registered"}), 409

        return jsonify({"error": "User registration failed"}), 500

    if not created:
        return jsonify({"error": "User registration failed"}), 500

    return jsonify({
        "message": "Registration successful",
        "user": created[0],
    }), 201


@auth_bp.post("/login")
def login():
    data = request.get_json(silent=True) or {}

    email = str(data.get("email", "")).strip().lower()
    password = str(data.get("password", ""))

    if not email or not password:
        return jsonify({"error": "Email and password are required"}), 400

    user = get_user_by_email(email)

    if not user:
        return jsonify({"error": "Invalid email or password"}), 401

    if user["status"] != "active":
        return jsonify({"error": "User account is not active"}), 403

    if user["role"] == "control":
        return jsonify({
            "error": "Control users must login using OTP"
        }), 403

    if not user.get("password_hash"):
        return jsonify({"error": "Password login is not configured"}), 401

    if not verify_password(user["password_hash"], password):
        return jsonify({"error": "Invalid email or password"}), 401

    token = create_token()
    expires_at = session_expiry()

    supabase_request(
        "POST",
        "auth_sessions",
        json={
            "user_id": user["id"],
            "token_hash": hash_token(token),
            "expires_at": expires_at,
        },
    )

    return jsonify({
        "message": "Login successful",
        "token": token,
        "expires_at": expires_at,
        "user": user_response(user),
    })


@auth_bp.post("/logout")
def logout():
    token = get_bearer_token()

    if not token:
        return jsonify({"error": "Bearer token is required"}), 401

    rows = supabase_request(
        "GET",
        "auth_sessions",
        params={
            "select": "id",
            "token_hash": f"eq.{hash_token(token)}",
            "revoked_at": "is.null",
            "limit": "1",
        },
    )

    if not rows:
        return jsonify({"error": "Invalid session"}), 401

    supabase_request(
        "PATCH",
        "auth_sessions",
        params={
            "token_hash": f"eq.{hash_token(token)}",
            "revoked_at": "is.null",
        },
        json={
            "revoked_at": datetime.now(timezone.utc).isoformat(),
        },
    )

    return jsonify({"message": "Logout successful"})


@auth_bp.post("/send-otp")
def send_otp():
    data = request.get_json(silent=True) or {}

    phone = normalize_phone(data.get("phone"))

    if not phone:
        return jsonify({"error": "Valid Indian phone number is required"}), 400

    user = get_user_by_phone(phone)

    if not user:
        return jsonify({"error": "Control user not found"}), 404

    if user["status"] != "active":
        return jsonify({"error": "User account is not active"}), 403

    if user["role"] != "control":
        return jsonify({"error": "OTP login is only for control users"}), 403

    try:
        result = mc_send_otp(phone)
    except Exception:
        return jsonify({"error": "OTP could not be sent"}), 502

    verification_id = result["verification_id"]

    supabase_request(
        "POST",
        "messagecentral_verifications",
        json={
            "user_id": user["id"],
            "phone": phone,
            "verification_id": verification_id,
            "status": "pending",
            "expires_at": datetime.now(timezone.utc).isoformat(),
        },
    )

    return jsonify({
        "message": "OTP sent",
        "verification_id": verification_id,
        "timeout": result.get("timeout"),
    })


@auth_bp.post("/verify-otp")
def verify_otp():
    data = request.get_json(silent=True) or {}

    verification_id = str(data.get("verification_id", "")).strip()
    otp = str(data.get("otp", "")).strip()

    if not verification_id or not otp:
        return jsonify({
            "error": "verification_id and otp are required"
        }), 400

    if not otp.isdigit() or not 4 <= len(otp) <= 8:
        return jsonify({"error": "Invalid OTP"}), 400

    rows = supabase_request(
        "GET",
        "messagecentral_verifications",
        params={
            "select": "id,user_id,phone,verification_id,status,expires_at",
            "verification_id": f"eq.{verification_id}",
            "limit": "1",
        },
    )

    if not rows:
        return jsonify({"error": "Verification not found"}), 404

    verification = rows[0]

    if verification["status"] != "pending":
        return jsonify({"error": "Verification is no longer pending"}), 400

    user_rows = supabase_request(
        "GET",
        "users",
        params={
            "select": "id,company_id,name,email,phone,password_hash,role,status",
            "id": f"eq.{verification['user_id']}",
            "limit": "1",
        },
    )

    if not user_rows:
        return jsonify({"error": "User not found"}), 404

    user = user_rows[0]

    if user["role"] != "control":
        return jsonify({"error": "Invalid control user"}), 403

    if user["status"] != "active":
        return jsonify({"error": "User account is not active"}), 403

    try:
        result = mc_verify_otp(verification_id, otp)
    except Exception:
        return jsonify({"error": "OTP verification failed"}), 502

    if not result.get("verified"):
        supabase_request(
            "PATCH",
            "messagecentral_verifications",
            params={
                "id": f"eq.{verification['id']}",
            },
            json={
                "status": "failed",
            },
        )

        return jsonify({"error": "Invalid OTP"}), 401

    supabase_request(
        "PATCH",
        "messagecentral_verifications",
        params={
            "id": f"eq.{verification['id']}",
        },
        json={
            "status": "verified",
            "verified_at": datetime.now(timezone.utc).isoformat(),
        },
    )

    token = create_token()
    expires_at = session_expiry()

    supabase_request(
        "POST",
        "auth_sessions",
        json={
            "user_id": user["id"],
            "token_hash": hash_token(token),
            "expires_at": expires_at,
        },
    )

    return jsonify({
        "message": "OTP login successful",
        "token": token,
        "expires_at": expires_at,
        "user": user_response(user),
    })
