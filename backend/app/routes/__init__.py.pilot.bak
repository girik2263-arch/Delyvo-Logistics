from app.routes.lifecycle import bp as lifecycle_bp
from app.routes.control_dashboard import bp as control_dashboard_bp
from app.routes.auth import auth_bp
from app.routes.companies import companies_bp
from app.routes.dashboard import dashboard_bp
from app.routes.shipments import shipments_bp


def register_routes(app):
    app.register_blueprint(lifecycle_bp)
    app.register_blueprint(control_dashboard_bp)
    app.register_blueprint(shipments_bp)
    app.register_blueprint(auth_bp)
    app.register_blueprint(companies_bp)
    app.register_blueprint(dashboard_bp)
